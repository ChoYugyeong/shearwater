{
 "kind": "Deployment",
 "apiVersion": "apps/v1",
 "metadata": {
  "name": "job",
  "labels": {
   "app": "job"
  }
 },
 "spec": {
  "replicas": 1,
  "selector": {
   "matchLabels": {
    "app": "job"
   }
  },
  "template": {
   "metadata": {
    "labels": {
     "app": "job"
    }
   },
   "spec": {
    "containers": [
     {
      "name": "busybox",
      "image": "busybox:1.36",
      "command": [
       "sleep",
       "3600"
      ],
      "resources": {}
     }
    ]
   }
  },
  "strategy": {}
 },
 "status": {}
}
