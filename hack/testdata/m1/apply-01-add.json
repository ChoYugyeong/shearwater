{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "m1-web"
  },
  "spec": {
    "replicas": 2,
    "selector": {
      "matchLabels": {
        "app": "m1-web"
      }
    },
    "strategy": {
      "type": "RollingUpdate",
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "m1-web"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "main",
            "image": "nginx:1.27",
            "env": [
              {
                "name": "KEEP",
                "value": "yes"
              },
              {
                "name": "REMOVE",
                "value": "old"
              }
            ],
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/data"
              }
            ]
          },
          {
            "name": "side",
            "image": "busybox:1.36"
          },
          {
            "name": "extra",
            "image": "busybox:1.36"
          }
        ],
        "volumes": [
          {
            "name": "data",
            "emptyDir": {}
          }
        ]
      }
    }
  }
}
