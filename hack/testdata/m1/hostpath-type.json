{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "m1-web"
  },
  "spec": {
    "replicas": 2,
    "selector": {
      "matchLabels": {
        "app": "m1-web"
      }
    },
    "strategy": {
      "type": "Recreate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "m1-web"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "extra",
            "image": "busybox:1.36"
          },
          {
            "name": "main",
            "image": "nginx:1.27",
            "env": [
              {
                "name": "KEEP",
                "value": "yes"
              }
            ],
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/data"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "data",
            "hostPath": {
              "path": "/tmp/shearwater-m1",
              "type": "DirectoryOrCreate"
            }
          }
        ]
      }
    }
  }
}
