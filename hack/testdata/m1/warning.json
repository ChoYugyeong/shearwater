{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "m1-warning",
    "labels": {
      "app": "m1"
    }
  },
  "spec": {
    "containers": [
      {
        "name": "main",
        "image": "nginx:1.27",
        "securityContext": {"runAsNonRoot": true},
        "livenessProbe": {
          "exec": {
            "command": [
              "true"
            ]
          },
          "periodSeconds": 10
        }
      }
    ]
  }
}
